# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=fastapi-k8s-app
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=appuser
POSTGRES_PASSWORD=apppassword
POSTGRES_DB=appdb

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redispassword
